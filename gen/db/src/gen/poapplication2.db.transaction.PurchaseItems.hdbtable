COLUMN TABLE poapplication2_db_transaction_PurchaseItems (
  GROSS_AMOUNT DECIMAL(10, 2),
  NET_AMOUNT DECIMAL(10, 2),
  TAX_AMOUNT DECIMAL(10, 2),
  CURRENCY_code NVARCHAR(3),
  NODE_KEY NVARCHAR(36) NOT NULL,
  PARENT_NODE_KEY NVARCHAR(36),
  PO_ITEM_POS INTEGER,
  PRODUCT_NODE_KEY NVARCHAR(36),
  PRIMARY KEY(NODE_KEY)
)